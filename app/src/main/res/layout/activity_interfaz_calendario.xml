<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6E8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header superior pastel (Ajustado) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="#A2DEFF"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical">

            <!-- Hamburguesa alineada totalmente a la izquierda -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/Burguer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
                app:navigationIconTint="#FFFFFF"
                android:contentDescription="Menú desplegable"/>

            <!-- Título centrado automáticamente -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Calendario"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Perfil alineado totalmente a la derecha -->
            <ImageButton
                android:id="@+id/btnUsuario"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_usuario"
                android:contentDescription="Perfil de usuario"
                app:tint="#FFFFFF"/>
        </RelativeLayout>

        <!-- Calendario con contraste de color activado -->
        <CalendarView
            android:id="@+id/calendarView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:theme="@style/ThemeOverlay.AppCompat.Light"
            android:focusedMonthDateColor="#333333"
            android:unfocusedMonthDateColor="#888888"
            android:weekNumberColor="#333333"
            android:selectedWeekBackgroundColor="#A2DEFF" />

        <!-- Título dinámico con la fecha seleccionada -->
        <TextView
            android:id="@+id/tvFechaSeleccionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Tareas del día"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Lista donde se muestran las tareas filtradas por la fecha seleccionada -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTareasCalendario"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="4dp"
            tools:listitem="@layout/item_tarea" />

    </LinearLayout>

    <!-- Menú Lateral -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/menu" />

</androidx.drawerlayout.widget.DrawerLayout>