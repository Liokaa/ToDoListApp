<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6E8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#70B5F6"
            android:gravity="center"
            android:padding="16dp">

            <Toolbar
                android:layout_width="match_parent"
                android:layout_height="70dp">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/Burguer"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginRight="50dp"
                    app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
                    app:navigationIconTint="#FFFFFF"
                    android:contentDescription="Menú desplegable"/>

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interfaz Principal \n Lista de Tareas"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginRight="50dp"/>

                <ImageButton
                    android:id="@+id/btnUsuario"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_usuario"
                    app:tint="#FFFFFF"/>
            </Toolbar>
        </LinearLayout>

        <!-- RecyclerView donde se despliegan las tareas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTareasMain"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingVertical="8dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_tarea" />

        <!-- Botón flotante para agregar tarea -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:padding="15dp">

            <Button
                android:id="@+id/btnAgregarTarea"
                android:layout_width="65dp"
                android:layout_height="70dp"
                android:text="+"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4A90E2"
                android:textSize="30dp"/>
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/menu" />

</androidx.drawerlayout.widget.DrawerLayout>