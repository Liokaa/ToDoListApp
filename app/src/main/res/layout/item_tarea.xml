<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 1. Borde/Indicador Lateral de Color según Categoría -->
        <View
            android:id="@+id/viewColorCategoria"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="#4A90E2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Checkbox en Azul pastel -->
            <CheckBox
                android:id="@+id/cbCompletada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#4A90E2" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <!-- 2. Etiqueta de Categoría (Texto con fondo suave) -->
                <TextView
                    android:id="@+id/tvCategoriaTarea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRABAJO"
                    android:textColor="#4A90E2"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvTituloTarea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Título de la tarea"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvDescripcionTarea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descripción de la tarea"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

                <!-- 3. Fecha de la Tarea -->
                <TextView
                    android:id="@+id/tvFechaTarea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 2026-03-25"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Botón eliminar original -->
            <ImageButton
                android:id="@+id/btnEliminarTarea"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#F48FB1"
                android:contentDescription="Enviar a papelera" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>